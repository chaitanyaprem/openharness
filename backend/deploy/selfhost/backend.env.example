# Copy to backend.env. Do not commit the copy.
NODE_ENV=production
PORT=8085
HARNESS_SELF_HOSTED=true
HARNESS_BILLING_ENABLED=false
# Shared bootstrap secret, or leave empty and use only HARNESS_PUBKEY_ALLOWLIST.
HARNESS_ENROLLMENT_TOKEN=replace-me
# Optional file inside the container. Mount it, one Ed25519 pubkey per line.
# HARNESS_PUBKEY_ALLOWLIST=/etc/harness/allowlist
# Empty STUN list is the default under HARNESS_SELF_HOSTED: WebRTC uses host
# addresses, including WireGuard. Set this only to add your own STUN server.
TERMINAL_P2P_STUN_URLS=
